# CoinFish local / shared env template.
# Copy to `.env` (gitignored) and fill in values. `.env.local` may override.

# --- Database ---------------------------------------------------------------
# Stable Neon / hosted Postgres (durable; used by Vercel when set as NEON).
# NEON=

# Ephemeral Neon *dev branch* connection string. Neon can auto-delete these
# after ~1 day — use for Alembic migration experiments and schema tests.
# Prefer this over local Docker when set: `npm run db:migrate` / `test:db:neon`.
# NEON_DEV=

# Explicit overrides (win over NEON_DEV / NEON):
# COINFISH_POSTGRES_URL=
# COINFISH_DB_URL=
# DATABASE_URL=

# --- XRPL Devnet (throwaway seeds only) -------------------------------------
# See backend/.env.example for the full bootstrap id list.
# COINFISH_ISSUER_SEED=
# COINFISH_ISSUER_ADDRESS=
# COINFISH_OPERATOR_SEED=
