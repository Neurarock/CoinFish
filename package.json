{
  "name": "coinfish",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "uv:sync": "uv sync --all-packages",
    "api": "uv run uvicorn backend.main:app --reload --port 8000",
    "api:devnet": "uv run uvicorn backend.main:app --reload --port 8000",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "cd db_service && uv run alembic upgrade head",
    "db:api": "uv run uvicorn db_service.main:app --reload --host 127.0.0.1 --port 8001",
    "svc:auth": "uv run uvicorn services.auth.main:app --reload --port 8002",
    "svc:pools": "uv run uvicorn services.pools.main:app --reload --port 8003",
    "svc:lending": "uv run uvicorn services.lending.main:app --reload --port 8004",
    "svc:borrowing": "uv run uvicorn services.borrowing.main:app --reload --port 8005",
    "svc:xrpl": "uv run uvicorn services.xrpl.main:app --reload --port 8006",
    "svc:admin": "uv run uvicorn services.admin.main:app --reload --port 8007",
    "web": "cd frontend && npm run dev -- --host 127.0.0.1",
    "dev": "sh scripts/dev.sh",
    "dev:devnet": "sh scripts/dev.sh",
    "build": "cd frontend && npm run build",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "uv run ruff check backend api db_service services",
    "lint:frontend": "cd frontend && npm run lint",
    "test:backend": "uv run pytest backend/tests services/test_health.py -q",
    "test:db": "uv run pytest db_service/tests -q",
    "test:frontend": "cd frontend && npm run build",
    "test:smoke": "uv run python scripts/smoke_api.py",
    "test:local": "npm run test:backend && npm run test:db && npm run test:frontend && npm run test:smoke"
  }
}
